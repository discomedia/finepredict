# FinePredict uses one master root .env for local development. Copy only the
# applicable values to Railway and Netlify through their CLIs; do not create
# package-level env files.

# Core API and persistence
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
OPENAI_API_KEY=
ODDPOOL_API_KEY=
FINEPREDICT_MODEL=gpt-5.6-luna
ADMIN_API_KEY=
ADMIN_EMAILS=
PORT=3001
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3001

# Managed Neon Auth and Disco Mail. Enable Magic Link in the Neon branch and
# subscribe its custom webhook to send.magic_link at /api/auth/neon-webhook.
NEON_AUTH_BASE_URL=
DISCO_MAIL_API_KEY=
DISCO_MAIL_FROM_EMAIL="FinePredict <hello@fp.discomedia.co>"

# Stripe. Watchlists and the metered developer API use separate recurring
# prices. The meter event name must match the Stripe Billing Meter exactly.
STRIPE_API_KEY=
STRIPE_WATCHLIST_PRICE_ID=
STRIPE_API_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_METER_EVENT_NAME=

# Developer API
API_KEY_HASH_SECRET=
# Paid per-key daily limit. Free accounts are fixed at 1 request per UTC minute
# and 10 requests per UTC day across all of their keys.
DEVELOPER_API_DAILY_LIMIT=1000

# Hourly monitoring. Dry run is the safe default: observations are persisted,
# but alert email and Stripe meter writes are suppressed.
MONITOR_DRY_RUN=true
POLYGON_RPC_URL=

# Public arbitrage scanner. Discovery rebuilds the cross-venue catalog hourly;
# bounded price refreshes update the strongest persisted pairs every five minutes.
ARBITRAGE_SERVICE_ENABLED=true
ARBITRAGE_RUN_DISCOVERY_ON_START=true
ARBITRAGE_DISCOVERY_INTERVAL_MINUTES=60
ARBITRAGE_PRICE_REFRESH_INTERVAL_SECONDS=300
ARBITRAGE_PRICE_REFRESH_MAX_PAIRS=24
ARBITRAGE_MINIMUM_SIMILARITY_PERCENT100=75
ARBITRAGE_MINIMUM_PRELIMINARY_EDGE_DOLLARS=0.015
ARBITRAGE_MINIMUM_NET_EDGE_DOLLARS=0.03
ARBITRAGE_DISCOVERY_MAX_BOOK_PAIRS=100
ARBITRAGE_MAX_PAIRS_PER_EVENT=10
ARBITRAGE_EVALUATION_BUDGET_DOLLARS=1000
ARBITRAGE_DIRECT_BOOK_CONCURRENCY=4

# Browser and Netlify Edge Function
VITE_API_BASE_URL=http://localhost:3001
VITE_NEON_AUTH_URL=
FINEPREDICT_API_BASE_URL=http://localhost:3001
