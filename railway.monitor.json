{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @finepredict/shared build && pnpm --filter @finepredict/api build"
  },
  "deploy": {
    "preDeployCommand": "pnpm db:migrate",
    "startCommand": "pnpm --filter @finepredict/api monitor",
    "cronSchedule": "7 * * * *",
    "restartPolicyType": "NEVER"
  }
}
