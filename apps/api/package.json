{
  "name": "@finepredict/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "monitor": "node dist/monitor.js",
    "monitor:dev": "tsx src/monitor.ts",
    "start": "node dist/server.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/app.integration.test.ts src/database/product-store.integration.test.ts",
    "pretypecheck": "pnpm --filter @finepredict/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discomedia/utils": "1.0.79",
    "@finepredict/shared": "workspace:*",
    "better-auth": "^1.6.23",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.7",
    "resend": "^6.17.2",
    "stripe": "^22.3.2",
    "viem": "^2.55.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
