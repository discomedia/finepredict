{
  "manifest_version": 3,
  "name": "FinePredict — Compare contract rules",
  "version": "0.2.1",
  "description": "Compare Polymarket and Kalshi contract fine print from Oddpool, or inspect either market directly.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*",
        "https://kalshi.com/*",
        "https://*.kalshi.com/*",
        "https://oddpool.com/arb-dashboard*",
        "https://www.oddpool.com/arb-dashboard*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
